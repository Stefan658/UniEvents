# Server Configuration
PORT=5000
FLASK_DEBUG=False

# Security (CHANGE THESE IN PRODUCTION)
SECRET_KEY=demo-secret-key-replace-me-in-production
# JWT_SECRET_KEY=demo-jwt-secret-key-replace-me-in-production

# Database Configuration
POSTGRES_DB=uni_events
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-demo-password
DATABASE_URL=postgresql://postgres:postgres-demo-password@db:5432/uni_events

# Email configuration (SMTP)
# If these variables are missing, email sending will be safely skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@uni-events.ro
SMTP_USE_TLS=True
SMTP_AUTH_REQUIRED=True
